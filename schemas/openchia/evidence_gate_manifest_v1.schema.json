{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openchia.local/schemas/evidence_gate_manifest_v1.schema.json",
  "title": "OpenChia Evidence Gate Manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "manifest_id", "revision", "success_criteria_hash", "gates"],
  "properties": {
    "schema_version": {"const": 1},
    "manifest_id": {"type": "string", "pattern": "^[a-z][a-z0-9_.:-]{0,127}$"},
    "revision": {"type": "integer", "minimum": 1},
    "success_criteria_hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "gates": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": [
          "gate_id", "description", "weight", "required_evidence_kind",
          "accepted_evidence_source", "minimum_evidence_count", "dependencies",
          "required_or_optional_status", "current_acceptance_state", "accepted_evidence_ids"
        ],
        "properties": {
          "gate_id": {"type": "string", "pattern": "^[a-z][a-z0-9_.:-]{0,127}$"},
          "description": {"type": "string", "minLength": 1},
          "weight": {"type": "number", "exclusiveMinimum": 0},
          "required_evidence_kind": {"type": "string"},
          "accepted_evidence_source": {"type": "string"},
          "minimum_evidence_count": {"type": "integer", "minimum": 1},
          "dependencies": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
          "required_or_optional_status": {"enum": ["required", "optional"]},
          "current_acceptance_state": {"enum": ["pending", "accepted", "blocked", "skipped", "rejected"]},
          "accepted_evidence_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string"}}
        }
      }
    }
  }
}
