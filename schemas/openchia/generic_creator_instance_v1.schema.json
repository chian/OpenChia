{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openchia.local/schemas/generic_creator_instance_v1.schema.json",
  "title": "OpenChia Generic Creator Instance v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "instance_id", "creator_type", "parent_instance_id", "local_goal",
    "immutable_parent_success_criteria_refs", "input_artifacts", "work_definition",
    "result_schema", "dependency_ids", "interface_contracts", "progress_measurement",
    "target", "minimum_delta", "stagnation_window", "evidence_requirements",
    "assignable_capabilities", "shared_state_namespace", "maximum_iterations",
    "maximum_child_episodes", "maximum_depth", "maximum_elapsed_time", "fault_ownership",
    "parent_gates_may_satisfy", "cancellation_behavior", "retry_behavior", "status",
    "may_create_child_creators"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "instance_id": {"$ref": "#/$defs/identifier"},
    "creator_type": {
      "enum": [
        "plan_context_creator", "worklist_factory_creator", "agent_loop_designer_creator",
        "integration_handoff_creator", "rarefaction_portfolio_creator",
        "qualification_release_creator", "generic_orchestrator_creator"
      ]
    },
    "parent_instance_id": {"oneOf": [{"$ref": "#/$defs/identifier"}, {"type": "null"}]},
    "local_goal": {"type": "string", "minLength": 1, "maxLength": 4096},
    "immutable_parent_success_criteria_refs": {"$ref": "#/$defs/uniqueIdentifiers"},
    "input_artifacts": {
      "type": "array", "uniqueItems": true,
      "items": {"$ref": "#/$defs/artifactReference"}
    },
    "work_definition": {"type": "object"},
    "result_schema": {"type": "object"},
    "dependency_ids": {"$ref": "#/$defs/uniqueIdentifiers"},
    "interface_contracts": {"type": "array", "items": {"type": "object"}},
    "progress_measurement": {
      "type": "object", "additionalProperties": false,
      "required": ["adapter_id", "gate_manifest_id", "description"],
      "properties": {
        "adapter_id": {"const": "evidence_gate_score_v1"},
        "gate_manifest_id": {"$ref": "#/$defs/identifier"},
        "description": {"type": "string", "minLength": 1, "maxLength": 1024}
      }
    },
    "target": {"type": "number", "exclusiveMinimum": 0, "maximum": 1},
    "minimum_delta": {"type": "number", "exclusiveMinimum": 0, "maximum": 1},
    "stagnation_window": {"type": "integer", "minimum": 2},
    "evidence_requirements": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["requirement_id", "evidence_kind_id", "acceptance_source_id", "minimum_count"],
        "properties": {
          "requirement_id": {"$ref": "#/$defs/identifier"},
          "evidence_kind_id": {"$ref": "#/$defs/identifier"},
          "acceptance_source_id": {"$ref": "#/$defs/identifier"},
          "minimum_count": {"type": "integer", "minimum": 1}
        }
      }
    },
    "assignable_capabilities": {"$ref": "#/$defs/uniqueIdentifiers"},
    "shared_state_namespace": {"type": "string", "pattern": "^[a-z][a-z0-9_.:/-]{0,255}$"},
    "maximum_iterations": {"type": "integer", "minimum": 1},
    "maximum_child_episodes": {"type": "integer", "minimum": 0},
    "maximum_depth": {"type": "integer", "minimum": 1},
    "maximum_elapsed_time": {"type": "number", "exclusiveMinimum": 0},
    "fault_ownership": {"type": "object"},
    "parent_gates_may_satisfy": {"$ref": "#/$defs/uniqueIdentifiers"},
    "cancellation_behavior": {"enum": ["cascade_immediately", "cascade_at_boundary"]},
    "retry_behavior": {
      "type": "object", "additionalProperties": false,
      "required": ["maximum_attempts", "require_new_evidence", "reopen_with_delta_only"],
      "properties": {
        "maximum_attempts": {"type": "integer", "minimum": 1},
        "require_new_evidence": {"type": "boolean"},
        "reopen_with_delta_only": {"type": "boolean"}
      }
    },
    "status": {"const": "pending"},
    "may_create_child_creators": {"type": "boolean"}
  },
  "$defs": {
    "identifier": {"type": "string", "pattern": "^[a-z][a-z0-9_.:-]{0,127}$"},
    "uniqueIdentifiers": {
      "type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/identifier"}
    },
    "artifactReference": {
      "type": "object", "additionalProperties": false,
      "required": ["artifact_id", "content_hash"],
      "properties": {
        "artifact_id": {"type": "string", "pattern": "^[a-z][a-z0-9_]{0,31}_[0-9a-f]{32,64}$"},
        "content_hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
      }
    }
  }
}
