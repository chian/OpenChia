{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openchia.local/schemas/creator_context_v1.schema.json",
  "title": "OpenChia Creator Context Manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "entrypoint_artifact_id",
    "artifact_references",
    "unresolved_question_ids"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "entrypoint_artifact_id": {
      "type": "string",
      "pattern": "^context_[0-9a-f]{64}$"
    },
    "artifact_references": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "artifact_id",
          "content_hash",
          "artifact_kind",
          "schema_version",
          "purpose",
          "required"
        ],
        "properties": {
          "artifact_id": {
            "type": "string",
            "pattern": "^context_[0-9a-f]{64}$"
          },
          "content_hash": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$"
          },
          "artifact_kind": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_-]{0,63}$"
          },
          "schema_version": {"type": "integer", "minimum": 1},
          "purpose": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_-]{0,63}$"
          },
          "required": {"type": "boolean"}
        }
      }
    },
    "unresolved_question_ids": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_]{0,31}_[0-9a-f]{32,64}$"
      }
    }
  }
}
